# 复制本文件为 .env 后再填写真实配置。
# Windows 用户可右键复制，改名为 .env；Cursor 用户可在左侧文件区右键 Duplicate。

# OpenAI 兼容接口密钥。不要把真实密钥提交到 Git。
API_KEY=请把你的API密钥填在这里

# 如果使用 DeepSeek，可保持下面两行；如果使用其他 OpenAI 兼容平台，请按平台文档修改。
OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 默认关闭大模型精读，脚本仍会用公开搜索结果生成报告。
# 改为 true 后，脚本会在 0.1 元人民币预算内调用 API 辅助抽取字段。
ENABLE_LLM_ENRICHMENT=false

# 预算保护：单日 API 调用成本上限，单位人民币。
MAX_DAILY_BUDGET_CNY=0.10

# 价格用于预算估算。请按所选模型最新价格填写，单位：人民币/1000 token。
INPUT_PRICE_CNY_PER_1K=0.001
OUTPUT_PRICE_CNY_PER_1K=0.002
RESERVED_OUTPUT_TOKENS=700

# 搜索深度控制。越大越慢；如启用 API，也更容易消耗预算。
MAX_RESULTS_PER_KEYWORD=6
MAX_FETCH_PAGES=10
HTTP_TIMEOUT_SECONDS=12

# 汇率仅用于把公开美元收入线索粗略换算为人民币，正式报告仍保留原始货币。
USD_TO_CNY=7.20

# 默认 false：无人工/API 复核时不自动把搜索结果放入“正式案例”，避免凑数。
ALLOW_AUTOMATIC_FORMAL=false

# 报告输出目录。
OUTPUT_DIR=reports

# Cursor 常驻定时脚本每天运行时间，使用本机时间 24 小时制。
RUN_AT_LOCAL_TIME=08:00

# 提示词文件位置。可自行修改 prompts/case_extract_prompt.txt。
PROMPT_FILE=prompts/case_extract_prompt.txt

# 搜索关键词。用英文竖线 | 分隔；也可以填写 KEYWORDS_FILE 指向一个每行一个关键词的文本文件。
SEARCH_KEYWORDS=Vibe Coding 独立创业案例|Vibe Coding 无代码 SaaS 项目|个人开发者 Vibe Coding 变现|轻量化 AI 工具 Vibe Coding 副业|一人 AI SaaS 创业 Vibe Coding|Cursor 独立开发 AI 工具|Claude Code 独立开发 SaaS|Lovable AI 创业案例|Bolt.new 创业案例|Replit Agent 创业案例|vibe coding indie hacker|built with Cursor startup|built with Claude side project|AI coding SaaS solo founder|Cursor AI SaaS revenue|Lovable app revenue|Bolt.new startup case study|Replit Agent SaaS founder|ship with Cursor indie hacker|AI coding tool indie maker revenue

# 可选：如需把关键词单独放到文件，取消下一行注释并创建 config/keywords.txt。
# KEYWORDS_FILE=config/keywords.txt
