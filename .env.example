# Vibe Coding 独立创业案例采集配置模板
# 使用方法：复制本文件为 .env，然后把 LLM_API_KEY 填成自己的真实 API Key。

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 默认仍保守限制每日 0.1 元；如果开启高完整度补全，可能需要适当提高。
DAILY_BUDGET_CNY=0.1
LLM_INPUT_PRICE_CNY_PER_1M_TOKENS=1
LLM_OUTPUT_PRICE_CNY_PER_1M_TOKENS=2

SEARCH_KEYWORDS=Vibe Coding独立创业案例|Vibe Coding无代码SaaS项目|个人开发者Vibe Coding变现|轻量化AI工具Vibe Coding副业|一人AI SaaS创业Vibe Coding

SEARCH_PROVIDER=duckduckgo
SERPER_API_KEY=

MAX_RESULTS_PER_KEYWORD=6
MAX_PAGES_PER_KEYWORD=8
MAX_SOURCE_CHARS=3500
MAX_LLM_OUTPUT_TOKENS=1600
REQUEST_TIMEOUT_SECONDS=20

# 质量增强：围绕每个候选案例追加检索多条公开来源，再二次补全。
ENABLE_ENRICHMENT=true
ENRICHMENT_RESULTS_PER_CASE=4
ENRICHMENT_SOURCE_CHARS=1800

# 正式案例完整度门槛。低于该分数的候选会被放到“信息不足候选”区。
MIN_COMPLETENESS_SCORE=0.72
WRITE_REJECTED_CANDIDATES=true

RUN_TIME=09:00
OUTPUT_DIR=outputs
EXCHANGE_RATES=USD:7.2,EUR:7.8,GBP:9.2,JPY:0.05,HKD:0.92
