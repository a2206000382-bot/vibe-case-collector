# 复制本文件为 .env 后再填写。不要把 .env 提交到 Git。

# 付费大模型接口：默认不开启，仅在 ENABLE_LLM_ENRICHMENT=true 时调用。
LLM_API_KEY=请粘贴你的apikey
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
ENABLE_LLM_ENRICHMENT=false

# 单日 API 预算，单位：人民币元。脚本会按 token 预估，达到阈值立刻停止后续付费增强。
MAX_DAILY_API_COST_CNY=0.10
CNY_PER_1K_INPUT_TOKENS=0.002
CNY_PER_1K_OUTPUT_TOKENS=0.008
MAX_LLM_OUTPUT_TOKENS=600
USD_CNY_RATE=7.20
EUR_CNY_RATE=7.80
GBP_CNY_RATE=9.10

# 搜索关键词用 || 分隔。可以自行增删，但不要删除分隔符。
SEARCH_KEYWORDS=Vibe Coding 独立创业案例||Vibe Coding 无代码 SaaS 项目||个人开发者 Vibe Coding 变现||轻量化 AI 工具 Vibe Coding 副业||一人 AI SaaS 创业 Vibe Coding||Cursor 独立开发 AI 工具||Claude Code 独立开发 SaaS||Lovable AI 创业案例||Bolt.new 创业案例||Replit Agent 创业案例||vibe coding indie hacker||built with Cursor startup||built with Claude side project||AI coding SaaS solo founder||Cursor AI SaaS revenue||Lovable app revenue||Bolt.new startup case study||Replit Agent SaaS founder||ship with Cursor indie hacker||AI coding tool indie maker revenue

# 可选：固定线索来源，用 || 分隔。网络搜索为空时仍可生成“今日线索池”。
SEED_URLS=https://www.indiehackers.com/||https://www.producthunt.com/topics/artificial-intelligence||https://github.com/topics/ai-tools||https://www.cursor.com/customers||https://lovable.dev/||https://bolt.new/||https://replit.com/ai

# 搜索深度和运行时间。
MAX_SEARCH_RESULTS_PER_KEYWORD=4
MAX_TOTAL_ITEMS=30
HTTP_TIMEOUT_SECONDS=12
RUN_AT=08:00
OUTPUT_DIR=reports
