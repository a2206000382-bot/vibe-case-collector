# 复制本文件为 .env 后再填写。不要把 .env 上传到 Git。

# ===== API 配置（可选）=====
# API_KEY 填你的 OpenAI 兼容接口密钥；脚本不会把它写进报告。
API_KEY=
API_BASE_URL=https://api.openai.com/v1/chat/completions
API_MODEL=gpt-4o-mini
ENABLE_LLM_ENRICHMENT=false
LLM_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=1200

# 单日 API 预算硬上限：0.10 元人民币。达到上限后立即停止后续 LLM 调用。
DAILY_API_BUDGET_CNY=0.10
LLM_INPUT_CNY_PER_1K_TOKENS=0.002
LLM_OUTPUT_CNY_PER_1K_TOKENS=0.008
MAX_LLM_SOURCES=6
MAX_LLM_SOURCE_CHARS=3500

# 美元收入换算人民币的汇率。可按当天汇率手动调整。
CNY_PER_USD=7.2

# ===== 调研范围 / 准备范围 =====
RESEARCH_SCOPE=仅收录公开可查证的 Vibe Coding / AI Coding 个人或小团队 AI工具创业真实落地案例；纯概念设想、无产品名、无来源链接、无关内容不得进入正式案例。

# ===== 搜索关键词 =====
# 多个关键词用英文竖线 | 分隔；也可以保留默认不填。
SEARCH_KEYWORDS=Vibe Coding 独立创业案例|Vibe Coding 无代码 SaaS 项目|个人开发者 Vibe Coding 变现|轻量化 AI 工具 Vibe Coding 副业|一人 AI SaaS 创业 Vibe Coding|Cursor 独立开发 AI 工具|Claude Code 独立开发 SaaS|Lovable AI 创业案例|Bolt.new 创业案例|Replit Agent 创业案例|vibe coding indie hacker|built with Cursor startup|built with Claude side project|AI coding SaaS solo founder|Cursor AI SaaS revenue|Lovable app revenue|Bolt.new startup case study|Replit Agent SaaS founder|ship with Cursor indie hacker|AI coding tool indie maker revenue

# ===== 抓取控制 =====
MAX_KEYWORDS_PER_RUN=12
MAX_RESULTS_PER_KEYWORD=5
MAX_PAGES_TO_FETCH=12
FETCH_PAGE_DETAILS=true
MAX_PAGE_CHARS=80000
HTTP_TIMEOUT_SECONDS=15
SEARCH_PAUSE_SECONDS=0.8

# ===== 自动运行时间（给教程和任务计划使用）=====
# Cursor 常驻定时示例：每天 08:00
CURSOR_CRON_TIME=08:00
# Windows 任务计划程序示例：每天 08:00
WINDOWS_TASK_TIME=08:00
