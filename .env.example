# =========================
# Vibe Coding 案例采集器配置
# =========================

# API 密钥只写在本地 .env，禁止提交到 Git。
# 后续每次检索都默认调用 API 辅助整理。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=kimi-k2.6
USE_LLM_EXTRACTION=true
REQUIRE_LLM_EXTRACTION=true

# 单日 API 预算。程序会强制把实际上限锁在 0.10 元人民币以内。
DAILY_API_BUDGET_RMB=0.10
LLM_INPUT_COST_RMB_PER_1K=0.001
LLM_OUTPUT_COST_RMB_PER_1K=0.002
MAX_LLM_SOURCE_CHARS=5000

# 准备范围 / 聚焦范围：可按你的选题微调。
PREPARED_SCOPE=仅检索公开可查证的 Vibe Coding 个人/小团队 AI 工具创业真实落地案例；纯概念、无产品名、无来源链接不进入正式案例。

# 每日运行时间，24 小时制。用于 --watch 常驻定时。
RUN_AT_HHMM=09:00

# 输出目录
OUTPUT_DIR=reports

# 搜索控制
SEARCH_PROVIDER=duckduckgo
MAX_RESULTS_PER_KEYWORD=5
FETCH_RESULT_PAGES=true
MAX_FETCHED_PAGES=18
HTTP_TIMEOUT_SECONDS=12
REQUEST_DELAY_SECONDS=0.8

# 运行结束后在终端输出完整可复制报告文本，同时仍保留 TXT/DOC 文件。
PRINT_REPORT_TEXT=true

# 汇率用于统一换算人民币，可自行按当天汇率调整。
USD_TO_CNY=7.20
GBP_TO_CNY=9.20
EUR_TO_CNY=7.80

# 中文关键词：用竖线 | 分隔，便于零基础用户直接修改。
SEARCH_KEYWORDS_ZH=Vibe Coding 独立创业案例|Vibe Coding 无代码 SaaS 项目|个人开发者 Vibe Coding 变现|轻量化 AI 工具 Vibe Coding 副业|一人 AI SaaS 创业 Vibe Coding|Cursor 独立开发 AI 工具|Claude Code 独立开发 SaaS|Lovable AI 创业案例|Bolt.new 创业案例|Replit Agent 创业案例

# 英文关键词：用竖线 | 分隔。
SEARCH_KEYWORDS_EN=vibe coding indie hacker|built with Cursor startup|built with Claude side project|AI coding SaaS solo founder|Cursor AI SaaS revenue|Lovable app revenue|Bolt.new startup case study|Replit Agent SaaS founder|ship with Cursor indie hacker|AI coding tool indie maker revenue

# 公开种子来源：搜索引擎无结果或不稳定时使用。
# 格式：标题@@链接，多条用 | 分隔。可以删除、替换或追加。
SEED_SOURCE_URLS=Creator Hunter Cursor Bolt revenue@@https://successaistories.com/paulius-masalskas-creator-hunter-17k-90-days-cursor-bolt/|Creator Hunter founder interview@@https://www.starterstory.com/paulius|TrendFeed Sebastian Volkis Indie Hackers@@https://www.indiehackers.com/post/tech/building-a-product-with-ai-in-four-days-and-hitting-12k-in-four-weeks-HxoUuTymcPNvhCNe8b6A|sensaro.ai Cursor Indie Hackers@@https://www.indiehackers.com/post/building-my-first-saas-with-cursor-a7c44bc8cd|fly.pieter.com Cursor ThreeJS@@https://fly.pieter.com/|fly.pieter.com vibe coding revenue@@https://www.vibecoding.wiki/showcase/fly-pieter-com-by-levelsio/|landpmjob.com Bolt.new case study@@https://www.news.aakashg.com/p/pm-guide-bolt|Lovable Indie Hackers ARR@@https://www.indiehackers.com/post/tech/hitting-100m-arr-in-eight-months-with-an-ai-software-builder-ONMaxjB3rix2PnBCnrDr|Bolt.new GitHub README@@https://github.com/stackblitz/bolt.new
