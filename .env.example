# 复制本文件为 .env 后再填写。不要把真实 .env 上传到 Git。

# 1) API 密钥：只在 ENABLE_LLM_ENRICHMENT=true 时使用。
OPENAI_API_KEY=请填写你的OpenAI兼容API密钥
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
ENABLE_LLM_ENRICHMENT=false

# 2) 单日 API 预算封顶：人民币 0.10 元。
# 脚本会在每次大模型调用前按 token 预估成本，预计超过此值时停止后续大模型提取。
DAILY_API_BUDGET_CNY=0.10
LLM_INPUT_CNY_PER_1K_TOKENS=0.002
LLM_OUTPUT_CNY_PER_1K_TOKENS=0.008
LLM_MAX_OUTPUT_TOKENS=700

# 3) 汇率：用于把公开美元/英镑收入线索换算成人民币。
EXCHANGE_USD_CNY=7.20
EXCHANGE_GBP_CNY=9.10

# 4) 搜索关键词：用英文竖线 | 分隔。可自行增删。
SEARCH_KEYWORDS=Vibe Coding 独立创业案例|Vibe Coding 无代码 SaaS 项目|个人开发者 Vibe Coding 变现|轻量化 AI 工具 Vibe Coding 副业|一人 AI SaaS 创业 Vibe Coding|Cursor 独立开发 AI 工具|Claude Code 独立开发 SaaS|Lovable AI 创业案例|Bolt.new 创业案例|Replit Agent 创业案例|vibe coding indie hacker|built with Cursor startup|built with Claude side project|AI coding SaaS solo founder|Cursor AI SaaS revenue|Lovable app revenue|Bolt.new startup case study|Replit Agent SaaS founder|ship with Cursor indie hacker|AI coding tool indie maker revenue

# 5) 兜底公开来源：搜索引擎失败时也会打开这些链接做线索，不作为无来源正式案例。
SOURCE_URLS=https://www.mrrstory.com/stories/from-1k-to-95k-mrr-in-30-days-the-solo-ai-tool-fixing-ugly-vibe-coded-apps|https://lovable.dev/blog/2025-01-17-from-idea-to-impact-yannis-journey-with-lovable|https://www.businessinsider.com/career-coach-vibe-code-ai-app-lovable-passive-income-2026-4|https://dev.to/jakub_inithouse/how-i-launched-14-saas-products-in-6-months-as-a-solo-founder-using-lovable-3hdm|https://blog.stackademic.com/i-built-a-saas-in-3-days-using-claude-code-it-makes-2-400-month-heres-the-entire-process-0af017932f9c

# 6) 抓取数量控制：数字越大，网页请求越多。
MAX_KEYWORDS_PER_RUN=8
MAX_RESULTS_PER_KEYWORD=5
MAX_PAGES_PER_RUN=20
REQUEST_TIMEOUT_SECONDS=18

# 7) 输出目录和定时运行时间。
REPORT_OUTPUT_DIR=reports
STATE_DIR=.collector_state
RUN_TIME_HHMM=08:00
