# 复制本文件为 .env 后再填写。不要把 .env 上传到 GitHub。

# 可选：OpenAI 兼容接口。密钥只能写在 .env 或系统环境变量里，禁止写进 Python 代码。
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
ENABLE_LLM_ENRICHMENT=false
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=900

# 成本控制：脚本会自动取 DAILY_BUDGET_CNY 和 HARD_DAILY_BUDGET_CNY 的较小值。
# 按本任务要求，硬上限默认锁定 0.10 元人民币/天；如不了解成本，请不要调高。
DAILY_BUDGET_CNY=0.10
HARD_DAILY_BUDGET_CNY=0.10
LLM_INPUT_PRICE_CNY_PER_1K=0.0015
LLM_OUTPUT_PRICE_CNY_PER_1K=0.0060

# 汇率用于把美元收入线索换算成人民币，可按当天汇率自行修改。
USD_TO_CNY_RATE=7.20

# 搜索范围和深度。数值越大越慢；启用 LLM 时也更容易消耗预算。
MAX_SEARCH_RESULTS_PER_KEYWORD=5
MAX_TOTAL_RESULTS=45
MAX_DEEP_PAGES=8
OUTPUT_DIR=reports
RUN_AT=08:00

# 中文关键词：用英文逗号、中文逗号或竖线分隔均可。
SEARCH_KEYWORDS=Vibe Coding 独立创业案例,Vibe Coding 无代码 SaaS 项目,个人开发者 Vibe Coding 变现,轻量化 AI 工具 Vibe Coding 副业,一人 AI SaaS 创业 Vibe Coding,Cursor 独立开发 AI 工具,Claude Code 独立开发 SaaS,Lovable AI 创业案例,Bolt.new 创业案例,Replit Agent 创业案例

# 英文关键词：用英文逗号、中文逗号或竖线分隔均可。
SEARCH_KEYWORDS_EN=vibe coding indie hacker,built with Cursor startup,built with Claude side project,AI coding SaaS solo founder,Cursor AI SaaS revenue,Lovable app revenue,Bolt.new startup case study,Replit Agent SaaS founder,ship with Cursor indie hacker,AI coding tool indie maker revenue

# 可选：人工补充公开来源链接。用英文逗号、中文逗号或竖线分隔。
# 适合放创始人访谈、产品官网、GitHub README、Indie Hackers 页面等一手/二手来源。
SOURCE_URLS=
