# 复制本文件为 .env 后再填写真实密钥；不要把 .env 发给别人。

# OpenAI 兼容接口配置。默认使用 Kimi（月之暗面）接口；其他服务商请改成它们的 chat/completions 地址。
LLM_API_KEY=请在这里粘贴你的API密钥
OPENAI_COMPATIBLE_API_URL=https://api.moonshot.cn/v1/chat/completions
LLM_MODEL=kimi-k2.6
# kimi-k2.6 当前只接受 temperature=1；如果换成 moonshot-v1-* 等模型，可按服务商文档改成 0。
LLM_TEMPERATURE=1

# 搜索关键词：用英文分号 ; 分隔。脚本不会在代码里写死关键词。
SEARCH_KEYWORDS=Vibe Coding独立创业案例;Vibe Coding无代码SaaS项目;个人开发者Vibe Coding变现;轻量化AI工具Vibe Coding副业;一人AI SaaS创业Vibe Coding

# 成本控制：默认每天最多预留/占用 0.1 元人民币 API 预算。
MAX_DAILY_API_BUDGET_CNY=0.1
INPUT_TOKEN_PRICE_CNY_PER_1M=2
OUTPUT_TOKEN_PRICE_CNY_PER_1M=8
LLM_MAX_OUTPUT_TOKENS=2500

# 采集深度。预算先到时会提前停止。
SEARCH_MAX_RESULTS_PER_KEYWORD=5
MAX_PAGES_TO_FETCH=12
MAX_CASES_PER_DAY=8
PAGE_TEXT_MAX_CHARS=6000
REQUEST_TIMEOUT_SECONDS=20

# 输出目录和定时运行时间。
OUTPUT_DIR=reports
SCHEDULE_TIME=02:00
