# Vibe Coding 独立创业案例采集配置
# 第一次使用时，只需要把 LLM_API_KEY 改成你的模型 API Key。

# OpenAI 兼容模型配置。示例默认使用 DeepSeek 官方兼容接口。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 单日模型 API 预算上限，单位：人民币元。按要求默认锁定 0.1 元。
DAILY_BUDGET_CNY=0.1

# 模型价格，用来计算 Token 成本。请按你的模型服务商价格表填写。
LLM_INPUT_PRICE_CNY_PER_1M_TOKENS=1
LLM_OUTPUT_PRICE_CNY_PER_1M_TOKENS=2

# 检索关键词，使用英文竖线 | 分隔。
SEARCH_KEYWORDS=Vibe Coding独立创业案例|Vibe Coding无代码SaaS项目|个人开发者Vibe Coding变现|轻量化AI工具Vibe Coding副业|一人AI SaaS创业Vibe Coding

# 搜索方式：duckduckgo 不需要搜索 API Key；serper 需要 SERPER_API_KEY。
SEARCH_PROVIDER=duckduckgo
SERPER_API_KEY=

# 每个关键词最多取多少条搜索结果、最多分析多少个网页。
MAX_RESULTS_PER_KEYWORD=6
MAX_PAGES_PER_KEYWORD=8

# 每个网页最多送给模型的文字数量，越大越费 Token。
MAX_SOURCE_CHARS=3500
MAX_LLM_OUTPUT_TOKENS=1600
REQUEST_TIMEOUT_SECONDS=20

# 每日常驻定时运行时间，24小时制，本机时间。
RUN_TIME=09:00

# 输出文件夹。
OUTPUT_DIR=outputs

# 月收入人民币换算汇率。脚本会把这段发给模型作为换算依据。
EXCHANGE_RATES=USD:7.2,EUR:7.8,GBP:9.2,JPY:0.05,HKD:0.92
